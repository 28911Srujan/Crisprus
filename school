<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GitHub File Vault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-4 flex flex-col items-center justify-center font-sans">

  <div class="w-full max-w-xl bg-slate-800 border border-slate-700 rounded-xl p-6 shadow-2xl space-y-6">
    
    <!-- Title & Detected Repo Info -->
    <div class="flex items-center justify-between border-b border-slate-700 pb-4">
      <div>
        <h1 class="text-xl font-bold text-white">GitHub Storage Vault</h1>
        <p id="repoInfo" class="text-xs text-indigo-400 mt-1">Detecting repository...</p>
      </div>
      <button onclick="clearToken()" class="text-xs text-slate-400 hover:text-red-400 underline">Reset Token</button>
    </div>

    <!-- Token Input (Only shows if not set) -->
    <div id="tokenSection" class="space-y-2">
      <label class="block text-xs font-semibold text-slate-300">GitHub Personal Access Token (PAT)</label>
      <div class="flex gap-2">
        <input type="password" id="patToken" placeholder="ghp_xxxxxxxxxxxx" class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 text-white">
        <button onclick="saveToken()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2 rounded-lg text-sm transition">Save Key</button>
      </div>
      <p class="text-[11px] text-slate-400">Needs <code>repo</code> scope permission to allow uploads.</p>
    </div>

    <!-- Main Content (Hidden until token exists) -->
    <div id="appSection" class="space-y-6 hidden">
      
      <!-- Upload Box -->
      <div class="space-y-3">
        <label class="block text-xs font-semibold text-slate-300">Upload File to Repo</label>
        <div class="border-2 border-dashed border-slate-600 hover:border-indigo-500 bg-slate-900/50 rounded-xl p-6 text-center cursor-pointer transition relative">
          <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="updateFileLabel()">
          <p id="fileLabel" class="text-sm text-slate-400">Click or drag file here to select</p>
        </div>
        <button onclick="uploadFile()" id="uploadBtn" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 rounded-lg text-sm transition shadow-lg flex items-center justify-center gap-2">
          Upload Confirm
        </button>
      </div>

      <!-- File Manager Box -->
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <h2 class="text-xs font-semibold text-slate-300">Files in Repository</h2>
          <button onclick="fetchFiles()" class="text-xs text-indigo-400 hover:underline">Refresh List</button>
        </div>
        <div id="fileList" class="bg-slate-900 border border-slate-700 rounded-lg divide-y divide-slate-800 max-h-64 overflow-y-auto">
          <p class="text-center py-4 text-xs text-slate-500">Loading files...</p>
        </div>
      </div>

    </div>

    <!-- Status Message -->
    <div id="statusMsg" class="hidden text-xs text-center p-2 rounded-lg"></div>

  </div>

  <script>
    let owner = '', repo = '', branch = 'main';

    // Auto-detect owner and repo from GitHub Pages URL structure (username.github.io/repo-name)
    function autoDetectRepo() {
      const host = window.location.hostname;
      const path = window.location.pathname.split('/').filter(Boolean);

      if (host.endsWith('.github.io')) {
        owner = host.split('.')[0];
        repo = path[0] || `${owner}.github.io`; // handles custom root pages or normal repos
      } else {
        // Fallback for local testing (index.html opened directly in browser)
        owner = prompt("Enter GitHub Username:") || "";
        repo = prompt("Enter Repository Name:") || "";
      }

      document.getElementById('repoInfo').innerText = `Target Repo: ${owner}/${repo} (${branch})`;
    }

    function init() {
      autoDetectRepo();
      const token = localStorage.getItem('gh_pat');
      if (token) {
        document.getElementById('tokenSection').classList.add('hidden');
        document.getElementById('appSection').classList.remove('hidden');
        fetchFiles();
      }
    }

    function saveToken() {
      const token = document.getElementById('patToken').value.trim();
      if (!token) return showStatus('Please enter a valid token', 'red');
      localStorage.setItem('gh_pat', token);
      document.getElementById('tokenSection').classList.add('hidden');
      document.getElementById('appSection').classList.remove('hidden');
      fetchFiles();
    }

    function clearToken() {
      localStorage.removeItem('gh_pat');
      document.getElementById('tokenSection').classList.remove('hidden');
      document.getElementById('appSection').classList.add('hidden');
    }

    function updateFileLabel() {
      const input = document.getElementById('fileInput');
      if (input.files.length > 0) {
        document.getElementById('fileLabel').innerText = `Selected: ${input.files[0].name}`;
      }
    }

    async function uploadFile() {
      const input = document.getElementById('fileInput');
      const token = localStorage.getItem('gh_pat');
      if (!input.files.length) return showStatus('Please select a file first!', 'red');

      const file = input.files[0];
      const btn = document.getElementById('uploadBtn');
      btn.innerText = "Uploading...";
      btn.disabled = true;

      try {
        const base64Content = await fileToBase64(file);
        const url = `https://api.github.com/repos/${owner}/${repo}/contents/${file.name}`;
        
        // Check if file already exists to get SHA for overwriting
        let sha = null;
        const checkRes = await fetch(url, { headers: { Authorization: `token ${token}` } });
        if (checkRes.ok) {
          const existingData = await checkRes.json();
          sha = existingData.sha;
        }

        const bodyData = {
          message: `Upload ${file.name} via Web Vault`,
          content: base64Content,
          branch: branch
        };
        if (sha) bodyData.sha = sha;

        const res = await fetch(url, {
          method: 'PUT',
          headers: {
            Authorization: `token ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(bodyData)
        });

        if (res.ok) {
          showStatus(`Success! Saved to GitHub repo.`, 'green');
          document.getElementById('fileInput').value = '';
          document.getElementById('fileLabel').innerText = 'Click or drag file here to select';
          fetchFiles();
        } else {
          const err = await res.json();
          showStatus(`Upload failed: ${err.message}`, 'red');
        }
      } catch (e) {
        showStatus(`Error: ${e.message}`, 'red');
      } finally {
        btn.innerText = "Upload Confirm";
        btn.disabled = false;
      }
    }

    async function fetchFiles() {
      const token = localStorage.getItem('gh_pat');
      const listEl = document.getElementById('fileList');
      listEl.innerHTML = '<p class="text-center py-4 text-xs text-slate-500">Loading files...</p>';

      try {
        const res = await fetch(`https://api.github.com/repos/${owner}/${repo}/contents?ref=${branch}`, {
          headers: { Authorization: `token ${token}` }
        });

        if (!res.ok) throw new Error('Could not fetch repo contents');

        const files = await res.json();
        listEl.innerHTML = '';

        files.filter(f => f.type === 'file').forEach(file => {
          const item = document.createElement('div');
          item.className = 'flex items-center justify-between p-3 text-xs';
          item.innerHTML = `
            <span class="truncate max-w-[220px] font-medium text-slate-200" title="${file.name}">${file.name}</span>
            <div class="flex items-center gap-2">
              <a href="${file.download_url}" download target="_blank" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1 rounded text-[11px] font-medium transition">Download</a>
              <button onclick="deleteFile('${file.name}', '${file.sha}')" class="text-slate-500 hover:text-red-400 p-1">✕</button>
            </div>
          `;
          listEl.appendChild(item);
        });
      } catch (e) {
        listEl.innerHTML = `<p class="text-center py-4 text-xs text-red-400">Error fetching files</p>`;
      }
    }

    async function deleteFile(filename, sha) {
      if (!confirm(`Delete ${filename}?`)) return;
      const token = localStorage.getItem('gh_pat');
      
      const res = await fetch(`https://api.github.com/repos/${owner}/${repo}/contents/${filename}`, {
        method: 'DELETE',
        headers: {
          Authorization: `token ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          message: `Delete ${filename}`,
          sha: sha,
          branch: branch
        })
      });

      if (res.ok) {
        showStatus('File deleted successfully', 'green');
        fetchFiles();
      } else {
        showStatus('Failed to delete file', 'red');
      }
    }

    function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result.split(',')[1]);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function showStatus(text, type) {
      const el = document.getElementById('statusMsg');
      el.innerText = text;
      el.className = `text-xs text-center p-2 rounded-lg ${type === 'green' ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-red-950 text-red-400 border border-red-800'}`;
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 4000);
    }

    init();
  </script>
</body>
</html>
